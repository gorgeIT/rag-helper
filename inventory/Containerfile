# RAG inventory - metadata inventory + classification of a file share.
#
# Build:  podman build -t rag-inventory .
# Run:    see README.md (share mounted read-only at /data, results in /out)
FROM docker.io/library/python:3.12-slim

# pypdf is only needed for --probe-pdf, but it is small, so always include it
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN uv pip install --system --no-cache pypdf

COPY scan.py /app/scan.py

# Unbuffered so progress lines on stderr show up immediately in `podman logs`
ENV PYTHONUNBUFFERED=1

# No USER on purpose: under rootless podman, container root maps to the
# invoking host user, which is the user that can read the share and write /out.
WORKDIR /out
VOLUME ["/out"]

ENTRYPOINT ["python3", "/app/scan.py"]
CMD ["--help"]
